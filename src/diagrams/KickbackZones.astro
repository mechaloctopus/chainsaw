---
import Plate from './Plate.astro';
---
<Plate caption="The three reactions, by where the bar touches. The orange quadrant is the one that puts the saw in your face.">
  <svg viewBox="0 0 440 230" class="dwg" role="img" aria-labelledby="kb-t kb-d">
    <title id="kb-t">Guide bar showing the kickback quadrant, pull-in and push-back zones</title>
    <desc id="kb-d">
      A guide bar seen from the side. The upper quadrant of the nose is marked as the
      kickback zone: contact there throws the saw up and back toward the operator. The
      underside of the bar pulls the saw forward into the wood. The top of the bar pushes
      the saw back toward the operator.
    </desc>

    <!-- bar -->
    <path class="metal" d="M40 96h300a30 30 0 0 1 0 38H40z" />
    <path class="ink" d="M8 84h36v62H8z" />
    <text x="14" y="122" class="num">saw</text>

    <!-- kickback quadrant on the nose -->
    <path class="danger-fill" d="M340 115a30 30 0 0 0-30-19v-8a38 38 0 0 1 38 27z" opacity="0.92" />
    <path class="danger" d="M370 115a55 55 0 0 0-55-55" />
    <path class="danger" d="M318 52 315 60l8 3" />
    <text x="286" y="40" class="onhaz" style="fill:var(--text)">Kickback quadrant</text>
    <text x="286" y="58" class="quiet">upper nose — rotates up and back at you</text>

    <!-- pull-in -->
    <path class="arrow" d="M150 158v22M150 180l-7-8M150 180l7-8" />
    <text x="164" y="178">Pull-in</text>
    <text x="164" y="196" class="quiet">bottom of bar — saw drags forward into the cut</text>

    <!-- push-back -->
    <path class="arrow" d="M150 80h-60M90 80l8-7M90 80l8 7" />
    <text x="160" y="84">Push-back</text>
    <text x="160" y="66" class="quiet">top of bar — saw comes back at you</text>

    <!-- nose ring -->
    <circle cx="340" cy="115" r="30" fill="none" class="rule" />
  </svg>
</Plate>
