---
import { nav, site } from '../data/site';
import { u, isCurrent } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---
<header class="masthead">
  <div class="shell masthead__in">
    <a class="wordmark" href={u('/')}>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="1" y="10.5" width="22" height="3" rx="1.5"></rect>
        <rect x="3" y="6" width="2.4" height="3.2"></rect>
        <rect x="8" y="6" width="2.4" height="3.2"></rect>
        <rect x="13" y="6" width="2.4" height="3.2"></rect>
        <rect x="18" y="6" width="2.4" height="3.2"></rect>
      </svg>
      Kaua‘i <span>Saw</span> School
    </a>
    <nav aria-label="Sections">
      {nav.map((item) => (
        <a href={u(item.href)} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="toggle no-print" href={u('/search/')} aria-label="Search the site">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.4 15.4 21 21"></path>
      </svg>
      <span class="sr-only">Search</span>
    </a>
    <ThemeToggle />
  </div>
</header>
