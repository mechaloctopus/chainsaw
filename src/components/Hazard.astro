---
/** A hazard callout. Breaks the rail and bleeds left — the only element on
 *  the page permitted to interrupt the structure, because --hazard is the only
 *  colour permitted to mean danger (Rule D-1).
 *
 *  Readable as plain text with CSS and JS off: it is an <aside> with a visible
 *  label, not a colour alone (Rule S-1). */
interface Props { label?: string }
const { label = 'Hazard' } = Astro.props;
---
<aside class="hazard" role="note">
  <p class="hazard__label">{label}</p>
  <slot />
</aside>
