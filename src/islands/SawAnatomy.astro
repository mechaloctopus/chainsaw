---
/** Interactive #2 — anatomy of the saw.
 *  Original SVG, themed by CSS variables, drawn to read at 360px (Rule D-8).
 *  Numbered callouts on the plate are labels, not controls — every control is
 *  a 56px row in the list below (Rule D-3), and that list is a complete,
 *  readable reference with JS off (Rule T-4). */
import { parts } from '../data/saw-parts';

const callouts: Array<{ n: number; cx: number; cy: number; tx: number; ty: number }> = [
  { n: 9,  cx: 40,  cy: 30,  tx: 74,  ty: 62 },
  { n: 4,  cx: 96,  cy: 22,  tx: 96,  ty: 44 },
  { n: 15, cx: 150, cy: 22,  tx: 143, ty: 66 },
  { n: 3,  cx: 198, cy: 24,  tx: 178, ty: 54 },
  { n: 10, cx: 256, cy: 32,  tx: 202, ty: 92 },
  { n: 11, cx: 300, cy: 32,  tx: 196, ty: 116 },
  { n: 1,  cx: 340, cy: 74,  tx: 340, ty: 106 },
  { n: 2,  cx: 392, cy: 160, tx: 392, ty: 133 },
  { n: 12, cx: 258, cy: 168, tx: 214, ty: 143 },
  { n: 13, cx: 212, cy: 196, tx: 198, ty: 165 },
  { n: 14, cx: 158, cy: 202, tx: 162, ty: 172 },
  { n: 8,  cx: 104, cy: 214, tx: 96,  ty: 104 },
  { n: 6,  cx: 62,  cy: 214, tx: 48,  ty: 140 },
  { n: 5,  cx: 22,  cy: 214, tx: 28,  ty: 186 },
  { n: 7,  cx: 16,  cy: 86,  tx: 38,  ty: 110 },
];
const byNum = new Map(parts.map((p) => [p.n, p.id]));
---
<div class="anatomy" data-anatomy>
  <figure class="anatomy__fig">
    <svg viewBox="0 0 460 250" role="img" aria-labelledby="saw-t saw-d" class="plate">
      <title id="saw-t">Side view of a gas chainsaw with fifteen numbered parts</title>
      <desc id="saw-d">
        A chainsaw seen from its right side, bar pointing right. Numbered callouts mark
        the guide bar, chain, chain brake handguard, front and rear handles, throttle
        trigger and interlock, master control switch, air filter cover, clutch cover,
        sprocket, bumper spikes, chain catcher, muffler, and the fuel and oil caps. Every
        part is described in the list below this drawing.
      </desc>

      <!-- ground shadow: a stump line so the saw is sitting on something -->
      <path class="ground" d="M8 232h444" />

      <!-- guide bar -->
      <path class="steel" data-part-shape="bar"
            d="M196 104h222a14 14 0 0 1 0 28H196z" />
      <!-- chain: dashed loop around the bar outline -->
      <path class="chain" data-part-shape="chain"
            d="M196 104h222a14 14 0 0 1 0 28H196z" />
      <!-- bar slot + oil hole -->
      <path class="slot" d="M232 114h70v8h-70z" />

      <!-- powerhead body -->
      <path class="body" data-part-shape="rearhandle"
            d="M22 104q-10 0-10 12v58q0 12 12 12h44q10 0 10-10v-12q0-8-8-8H44q-6 0-6-6v-34q0-12 12-12h10q8 0 8-8v-8q0-8-8-8H30q-8 0-8 8z" />
      <path class="body" d="M70 58q-14 0-14 14v92q0 14 14 14h96q16 0 16-16V86q0-14-16-18l-40-10z" />

      <!-- anti-vibration mount hint -->
      <path class="detail" d="M60 118h14v10H60zM60 142h14v10H60z" />

      <!-- air filter cover -->
      <path class="panel" data-part-shape="filter" d="M76 56h50q8 0 8 8v16H68V64q0-8 8-8z" />
      <path class="detail" d="M80 62h42v3H80zM80 68v3h42v-3zM80 74h42v3H80z" />

      <!-- front handle: over the top and down the left -->
      <path class="tube" data-part-shape="tophandle"
            d="M44 148V58q0-14 14-14h84q12 0 12 12v10" />

      <!-- chain brake handguard -->
      <path class="tube" data-part-shape="handguard" d="M170 50 186 96" />
      <path class="guardflag" data-part-shape="handguard" d="M158 44h26l8 12h-26z" />

      <!-- clutch cover -->
      <path class="cover" data-part-shape="clutchcover"
            d="M166 84 216 96v52l-50 10z" />
      <!-- sprocket, behind the cover -->
      <circle class="ghost" data-part-shape="sprocket" cx="192" cy="118" r="17" />
      <circle class="ghost-dot" cx="192" cy="118" r="4" />
      <!-- bar nuts -->
      <circle class="detail-fill" cx="206" cy="104" r="5" />
      <circle class="detail-fill" cx="206" cy="134" r="5" />

      <!-- bumper spikes -->
      <path class="steel" data-part-shape="dogs" d="M198 134l18 10-18 4zM198 146l14 8-14 4z" />
      <!-- chain catcher -->
      <path class="steel" data-part-shape="catcher" d="M186 150h14l-3 16h-11z" />

      <!-- muffler + spark arrestor -->
      <path class="panel" data-part-shape="muffler" d="M138 142h32q6 0 6 6v18q0 6-6 6h-32z" />
      <path class="detail" d="M148 150h20v4h-20zM148 158h20v4h-20zM148 166h20v4h-20z" />

      <!-- caps -->
      <circle class="cap" data-part-shape="caps" cx="143" cy="72" r="11" />
      <circle class="cap" data-part-shape="caps" cx="52" cy="170" r="11" />

      <!-- controls -->
      <path class="detail-fill" data-part-shape="switch" d="M86 96h22v10H86z" />
      <path class="detail-fill" data-part-shape="interlock" d="M32 106h22v7H32z" />
      <path class="detail-fill" data-part-shape="throttle" d="M34 124h20l-2 14H36z" />

      <!-- callouts: labels, never controls -->
      <g class="calls" aria-hidden="true">
        {callouts.map((c) => (
          <g class="call" data-call={byNum.get(c.n)}>
            <line x1={c.cx} y1={c.cy} x2={c.tx} y2={c.ty} />
            <circle cx={c.cx} cy={c.cy} r="13" />
            <text x={c.cx} y={c.cy} dy="0.36em">{c.n}</text>
          </g>
        ))}
      </g>
    </svg>
    <figcaption>
      Right side of a mid-size gas saw. Your saw will differ in detail; the jobs and the
      failures do not.
    </figcaption>
  </figure>

  <ol class="parts">
    {parts.map((p) => (
      <li>
        <details data-part={p.id}>
          <summary>
            <span class="parts__n">{p.n}</span>
            <span class="parts__name">{p.name}</span>
          </summary>
          <div class="parts__body">
            <p><b>Job.</b> {p.job}</p>
            <p class="parts__fail"><b>Fails like this.</b> {p.fail}</p>
          </div>
        </details>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-anatomy]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    root.querySelectorAll<HTMLDetailsElement>('details[data-part]').forEach((d) => {
      d.addEventListener('toggle', () => {
        const id = d.dataset.part!;
        svg.querySelectorAll(`[data-part-shape="${id}"], [data-call="${id}"]`).forEach((el) =>
          el.classList.toggle('is-on', d.open),
        );
      });
    });
  });
</script>

<style>
  .anatomy { display: grid; gap: 1.25rem; }
  .anatomy__fig { margin: 0; }
  .plate {
    width: 100%;
    height: auto;
    background: var(--surface-lift);
    border: 1px solid var(--line);
  }
  .anatomy__fig figcaption {
    font-size: var(--text-meta);
    color: var(--text-quiet);
    margin-top: 0.5rem;
    max-width: var(--measure);
  }

  /* Diagram ink. Every value comes from a token. */
  .plate .ground { stroke: var(--line); stroke-width: 2; stroke-dasharray: 3 7; fill: none; }
  .plate .body { fill: var(--color-canopy); }
  .plate .panel { fill: color-mix(in oklab, var(--color-canopy) 74%, var(--color-ink)); }
  .plate .cover { fill: color-mix(in oklab, var(--color-canopy) 60%, var(--color-ink)); }
  .plate .steel { fill: var(--color-steel); }
  .plate .slot { fill: var(--surface-lift); }
  .plate .chain {
    fill: none;
    stroke: var(--text);
    stroke-width: 5;
    stroke-dasharray: 7 6;
    stroke-linecap: butt;
  }
  .plate .tube {
    fill: none;
    stroke: var(--text);
    stroke-width: 13;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plate .guardflag { fill: var(--text); }
  .plate .detail { fill: color-mix(in oklab, var(--color-pith) 55%, transparent); }
  .plate .detail-fill { fill: var(--color-pith); }
  .plate .cap { fill: var(--color-steel); stroke: var(--color-ink); stroke-width: 2; }
  .plate .ghost { fill: none; stroke: var(--color-pith); stroke-width: 2; stroke-dasharray: 4 4; }
  .plate .ghost-dot { fill: var(--color-pith); }

  .plate .call line { stroke: var(--line-strong); stroke-width: 1.5; }
  .plate .call circle { fill: var(--surface-lift); stroke: var(--text); stroke-width: 2; }
  .plate .call text {
    fill: var(--text);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    text-anchor: middle;
  }

  /* Selected part. Not orange: a highlight is not a hazard (Rule D-1). */
  .plate .is-on { outline: none; }
  .plate .call.is-on circle { fill: var(--text); stroke: var(--text); }
  .plate .call.is-on text { fill: var(--surface-lift); }
  .plate .call.is-on line { stroke: var(--text); stroke-width: 2.5; }
  .plate [data-part-shape].is-on { stroke: var(--accent); stroke-width: 3; paint-order: stroke; }
  .plate .chain.is-on { stroke: var(--accent); }
  .plate .tube.is-on { stroke: var(--accent); }

  .parts { list-style: none; padding: 0 !important; margin: 0; display: grid; gap: 0; }
  .parts li { max-width: none; }
  .parts details { border-bottom: 1px solid var(--line); }
  .parts li:first-child details { border-top: 1px solid var(--line); }
  .parts summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--tap);
    padding: 0.65rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .parts summary::-webkit-details-marker { display: none; }
  .parts summary:hover { background: var(--surface-inset); }
  .parts__n {
    flex: none;
    width: 2rem; height: 2rem;
    display: grid; place-content: center;
    border: 2px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  details[open] .parts__n { background: var(--text); color: var(--surface); border-color: var(--text); }
  .parts__name { font-family: var(--font-display); font-weight: 800; font-size: 1.0625rem; letter-spacing: -0.01em; }
  .parts summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text-quiet);
  }
  details[open] summary::after { content: '−'; }
  .parts__body { padding: 0 0.25rem 1rem 3rem; display: grid; gap: 0.5rem; }
  .parts__body p { max-width: var(--measure); }
  .parts__fail { border-left: 3px solid var(--accent); padding-left: 0.7rem; }
</style>
